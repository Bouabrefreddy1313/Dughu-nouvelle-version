# =============================================================================
# Dughu Web — variables d'environnement
# Copier en `.env` sur le serveur puis remplir : cp .env.example .env
# `chmod 600 .env` — ce fichier contient des secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Port d'écoute sur l'hôte (loopback uniquement)
# -----------------------------------------------------------------------------
# À changer si 3000 est déjà occupé sur le serveur. La même valeur doit être
# reportée dans l'upstream de deploy/nginx/dughu.conf.
APP_PORT=3000

# -----------------------------------------------------------------------------
# API Dughu (backend Laravel) — SOURCE DE VÉRITÉ de l'application
# -----------------------------------------------------------------------------
# Environnement de recette (testing.dughu.com) -> API de test.
# Pour un déploiement de production réelle, basculer sur l'API de prod.
DUGHU_API_BASE_URL=https://apitest.dughu.com/api

# Jeton envoyé dans l'en-tête X-AppApiToken. OBLIGATOIRE :
# sans lui, toutes les routes API répondent 500.
DUGHU_API_KEY=

# Délai max d'un appel à l'API Dughu, en SECONDES (défaut : 5)
DUGHU_API_TIMEOUT=5
# Nombre de tentatives supplémentaires en cas d'échec (défaut : 2)
DUGHU_API_RETRY_TIMES=2
# Pause entre deux tentatives, en MILLISECONDES (défaut : 200)
DUGHU_API_RETRY_SLEEP=200

# -----------------------------------------------------------------------------
# SMTP — envoi des codes OTP
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# -----------------------------------------------------------------------------
# Variables PUBLIQUES (exposées au navigateur)
# -----------------------------------------------------------------------------
# ATTENTION : celle-ci est inlinée dans le bundle client AU MOMENT DU BUILD.
# La modifier impose de reconstruire l'image (docker compose build), un simple
# restart ne suffit pas. Si elle est vide, le bouton "Connexion Google" est
# désactivé côté client.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# Firebase Client SDK (Web v10+) — Messagerie temps réel (dughu-48cd0)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=dughu-48cd0.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dughu-48cd0
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=dughu-48cd0.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=812008509620
NEXT_PUBLIC_FIREBASE_APP_ID=1:812008509620:web:b4ba3b0055e621bfa607e1
# Collection Firestore (conversations en production, conversations_test en recette/test)
NEXT_PUBLIC_FIREBASE_CONVERSATIONS_COLLECTION=conversations

# -----------------------------------------------------------------------------
# Firebase Admin SDK (serveur uniquement — FCM Push, Custom Token Auth)
# -----------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=dughu-48cd0
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
